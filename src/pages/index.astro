---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import profileData from '../content/profile/index.json';

const recentWritings = (await getCollection('writings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const recentShips = (await getCollection('ships'))
  .sort((a, b) => b.data.year.localeCompare(a.data.year))
  .slice(0, 4);

const recentThoughts = (await getCollection('thoughts'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="dvvn – internet space" description={profileData.bio || 'personal corner on the web'}>
  <!-- Bio / Intro (Editable from CMS) -->
  <section class="mb-12">
    <h1 class="text-xl font-semibold mb-3 tracking-tight" style="color: var(--text-primary);">
      {profileData.headline || "hey! I'm Yudi"} <span class="font-normal" style="color: var(--text-muted);">{profileData.greetingEmoji || '👋'}</span>
    </h1>
    <p class="text-sm leading-relaxed mb-4 whitespace-pre-line" style="color: var(--text-secondary);">
      {profileData.bio || "I'm a multimedia creator exploring the intersection of visual storytelling (photography & video) and web technology. Welcome to my creative corner on the internet."}
    </p>
  </section>

  <!-- Ships / Works Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-tag">ships & works</h2>
      <a href="/ships" class="section-tag hover:opacity-80">all works →</a>
    </div>

    <div class="space-y-3">
      {recentShips.map((ship) => (
        <div class="ship-card">
          <div class="flex items-center justify-between mb-1.5 gap-2">
            <h3 class="ship-title">
              {ship.data.link ? (
                <a href={ship.data.link} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 flex items-center gap-1">
                  {ship.data.title}
                  <span style="color: var(--text-muted); font-size: 0.75rem;">↗</span>
                </a>
              ) : (
                ship.data.title
              )}
            </h3>
            <span class="status-badge">
              {ship.data.category}
            </span>
          </div>
          
          {ship.data.coverImage && (
            <div class="mb-2.5 rounded overflow-hidden border" style="border-color: var(--border);">
              <img src={ship.data.coverImage} alt={ship.data.title} class="w-full h-40 object-cover" />
            </div>
          )}

          <p class="ship-desc mb-2.5">{ship.data.description}</p>
          
          <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t" style="border-color: var(--border);">
            <div class="flex gap-1.5 flex-wrap">
              {ship.data.tools.map((tool) => (
                <span class="tech-tag">
                  {tool}
                </span>
              ))}
            </div>

            <div class="flex gap-3 text-xs font-mono">
              {ship.data.videoUrl && (
                <a href={ship.data.videoUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--accent);">
                  watch video ↗
                </a>
              )}
              {ship.data.link && (
                <a href={ship.data.link} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-primary);">
                  view work ↗
                </a>
              )}
              {ship.data.github && (
                <a href={ship.data.github} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-muted);">
                  source ↗
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Writings Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-tag">writings</h2>
      <a href="/writings" class="section-tag hover:opacity-80">all writings →</a>
    </div>

    <div>
      {recentWritings.map((post) => (
        <a href={`/writings/${post.slug}`} class="post-row">
          <span class="post-title">{post.data.title}</span>
          <span class="post-date">{formatDate(post.data.publishDate)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Thoughts Section -->
  {recentThoughts.length > 0 && (
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-tag">thoughts</h2>
        <a href="/thoughts" class="section-tag hover:opacity-80">all thoughts →</a>
      </div>

      <div class="space-y-3">
        {recentThoughts.map(async (thought) => {
          const { Content } = await thought.render();
          return (
            <div class="thought-bubble">
              <div class="text-[11px] font-mono mb-1.5" style="color: var(--text-muted);">{formatDate(thought.data.publishDate)}</div>
              <div class="thought-content prose">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
