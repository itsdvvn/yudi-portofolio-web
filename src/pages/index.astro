---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import profileData from '../content/profile/index.json';

const recentWritings = (await getCollection('writings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const recentShips = (await getCollection('ships'))
  .sort((a, b) => b.data.year.localeCompare(a.data.year))
  .slice(0, 4);

const recentThoughts = (await getCollection('thoughts'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const education = profileData.education || [];
const experience = profileData.experience || [];
const awards = profileData.awards || [];
const activities = profileData.recentActivities || [];
const roles = profileData.roles || [];
---

<BaseLayout title="dvvn – internet space" description={profileData.bio || 'personal corner on the web'}>
  <!-- Bio / Profile Hero Section -->
  <section class="mb-12">
    {(profileData.avatarImage || profileData.avatarUrl) && (
      <div class="mb-6">
        <img 
          src={profileData.avatarImage || profileData.avatarUrl} 
          alt={profileData.headline || "Profile"} 
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border-2 shadow-sm"
          style="border-color: var(--border);"
        />
      </div>
    )}

    <h1 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight" style="color: var(--text-primary);">
      {profileData.headline || "Halo, saya Yudi"}
    </h1>
    
    <p class="text-sm leading-relaxed mb-4 whitespace-pre-line" style="color: var(--text-secondary);">
      {profileData.bio}
    </p>

    {roles.length > 0 && (
      <div class="mt-4">
        <p class="text-sm font-medium mb-2.5" style="color: var(--text-primary);">
          Secara umum, saya dikenal sebagai:
        </p>
        <ul class="space-y-3.5 pl-4 list-disc text-sm" style="color: var(--text-secondary);">
          {roles.map((role) => (
            <li>
              <strong style="color: var(--text-primary);">{role.title}</strong>
              <p class="mt-0.5 text-xs sm:text-sm leading-relaxed" style="color: var(--text-secondary);">
                {role.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <!-- 🎓 Pendidikan Section (Only shows if there is data) -->
  {education.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <h2 class="text-base font-bold flex items-center gap-1.5" style="color: var(--text-primary);">
          <span>🎓</span> Pendidikan
        </h2>
      </div>

      <div class="space-y-3">
        {education.map((edu) => (
          <div class="ship-card p-3 sm:p-4">
            <h3 class="text-sm font-semibold mb-1" style="color: var(--text-primary);">
              {edu.degree}
            </h3>
            <p class="text-xs sm:text-sm mb-1" style="color: var(--text-secondary);">
              {edu.institution}
            </p>
            <span class="text-xs font-mono" style="color: var(--text-muted);">
              {edu.year}
            </span>
          </div>
        ))}
      </div>

      {profileData.educationPhoto && (
        <div class="mt-4 rounded-xl overflow-hidden border shadow-sm" style="border-color: var(--border);">
          <img src={profileData.educationPhoto} alt="Momen Pendidikan / Wisuda" class="w-full h-auto max-h-[420px] object-cover" />
        </div>
      )}
    </section>
  )}

  <!-- 🏢 Pengalaman Section (Only shows if there is data) -->
  {experience.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <h2 class="text-base font-bold flex items-center gap-1.5" style="color: var(--text-primary);">
          <span>🏢</span> Pengalaman
        </h2>
      </div>

      <ul class="space-y-4 pl-4 list-disc text-sm" style="color: var(--text-secondary);">
        {experience.map((exp) => (
          <li>
            <strong style="color: var(--text-primary);">{exp.position}</strong>
            {exp.period && (
              <span class="text-xs font-mono block sm:inline sm:ml-1" style="color: var(--text-muted);">
                ({exp.period})
              </span>
            )}
            <p class="mt-1 text-xs sm:text-sm leading-relaxed" style="color: var(--text-secondary);">
              {exp.description}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 🏆 Penghargaan Section (Only shows if there is data) -->
  {awards.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="text-base font-bold flex items-center gap-1.5" style="color: var(--text-primary);">
          <span>🏆</span> Penghargaan
        </h2>
      </div>
      <p class="text-xs sm:text-sm mb-3" style="color: var(--text-secondary);">
        Berikut beberapa penghargaan yang telah saya peroleh:
      </p>

      <ul class="space-y-2 pl-4 list-disc text-xs sm:text-sm" style="color: var(--text-secondary);">
        {awards.map((award) => (
          <li>
            <span style="color: var(--text-primary);">{award.title}</span>
            {award.year && (
              <span class="font-mono text-xs ml-1" style="color: var(--text-muted);">
                ({award.year})
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 📣 Aktivitas Terbaru Section (Only shows if there is data) -->
  {activities.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="text-base font-bold flex items-center gap-1.5" style="color: var(--text-primary);">
          <span>📣</span> Aktivitas Terbaru
        </h2>
      </div>
      <p class="text-xs sm:text-sm mb-3" style="color: var(--text-secondary);">
        Berikut beberapa kegiatan seminar, pameran, atau karya terbaru yang telah saya lakukan:
      </p>

      <ul class="space-y-2 pl-4 list-disc text-xs sm:text-sm" style="color: var(--text-secondary);">
        {activities.map((act) => (
          <li>
            <span style="color: var(--text-primary);">{act.title}</span>
            {act.locationDate && (
              <span class="font-mono text-xs ml-1" style="color: var(--text-muted);">
                ({act.locationDate})
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Ships / Works Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-tag">ships & works</h2>
      <a href="/ships" class="section-tag hover:opacity-80">all works →</a>
    </div>

    <div class="space-y-3">
      {recentShips.map((ship) => (
        <div class="ship-card">
          <div class="flex items-center justify-between mb-1.5 gap-2">
            <h3 class="ship-title">
              {ship.data.link ? (
                <a href={ship.data.link} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 flex items-center gap-1">
                  {ship.data.title}
                  <span style="color: var(--text-muted); font-size: 0.75rem;">↗</span>
                </a>
              ) : (
                ship.data.title
              )}
            </h3>
            <span class="status-badge">
              {ship.data.category}
            </span>
          </div>
          
          {ship.data.coverImage && (
            <div class="mb-2.5 rounded overflow-hidden border" style="border-color: var(--border);">
              <img src={ship.data.coverImage} alt={ship.data.title} class="w-full h-40 object-cover" />
            </div>
          )}

          <p class="ship-desc mb-2.5">{ship.data.description}</p>
          
          <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t" style="border-color: var(--border);">
            <div class="flex gap-1.5 flex-wrap">
              {ship.data.tools.map((tool) => (
                <span class="tech-tag">
                  {tool}
                </span>
              ))}
            </div>

            <div class="flex gap-3 text-xs font-mono">
              {ship.data.videoUrl && (
                <a href={ship.data.videoUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--accent);">
                  watch video ↗
                </a>
              )}
              {ship.data.link && (
                <a href={ship.data.link} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-primary);">
                  view work ↗
                </a>
              )}
              {ship.data.github && (
                <a href={ship.data.github} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-muted);">
                  source ↗
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Writings Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-tag">writings</h2>
      <a href="/writings" class="section-tag hover:opacity-80">all writings →</a>
    </div>

    <div>
      {recentWritings.map((post) => (
        <a href={`/writings/${post.slug}`} class="post-row">
          <span class="post-title">{post.data.title}</span>
          <span class="post-date">{formatDate(post.data.publishDate)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Thoughts Section -->
  {recentThoughts.length > 0 && (
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-tag">thoughts</h2>
        <a href="/thoughts" class="section-tag hover:opacity-80">all thoughts →</a>
      </div>

      <div class="space-y-3">
        {recentThoughts.map(async (thought) => {
          const { Content } = await thought.render();
          return (
            <div class="thought-bubble">
              <div class="text-[11px] font-mono mb-1.5" style="color: var(--text-muted);">{formatDate(thought.data.publishDate)}</div>
              <div class="thought-content prose">
                <Content />
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
