---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reader } from '../lib/reader';
import { isArticlePublished, parsePublishDateTime } from '../lib/schedule';
import Markdoc from '@markdoc/markdoc';

// 1. Read Site & SEO Config
const siteData = (await (reader.singletons as any).site?.read()) || (await (reader.singletons as any).profile?.read()) || {};

// 2. Read Thoughts Live (Cari Pinned Thought untuk Quote Homepage)
const thoughtSlugs = await reader.collections.thoughts.list();
const thoughtsRaw = await Promise.all(
  thoughtSlugs.map(async (slug) => {
    const data = await reader.collections.thoughts.read(slug);
    if (!data) return null;
    let htmlContent = '';
    try {
      const contentAst = await data.content();
      const transformedContent = Markdoc.transform(contentAst.node || contentAst);
      htmlContent = Markdoc.renderers.html(transformedContent);
    } catch (e) {}
    return { slug, ...data, htmlContent };
  })
);

const sortedThoughts = thoughtsRaw
  .filter(Boolean)
  .sort((a, b) => {
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    return parsePublishDateTime(b.publishDate).valueOf() - parsePublishDateTime(a.publishDate).valueOf();
  });

// Ambil thought yang di-pin (atau thought terbaru jika belum ada yang di-pin)
const featuredThought = sortedThoughts.find(t => t.pinned) || sortedThoughts[0] || null;

// 3. Read Ships Live
const shipSlugs = await reader.collections.ships.list();
const shipsRaw = await Promise.all(
  shipSlugs.map(async (slug) => {
    const data = await reader.collections.ships.read(slug);
    return { slug, ...data };
  })
);
const recentShips = shipsRaw
  .filter(Boolean)
  .sort((a, b) => (b.year || '').localeCompare(a.year || ''))
  .slice(0, 4);

// 4. Read Writings Live
const writingSlugs = await reader.collections.writings.list();
const writingsRaw = await Promise.all(
  writingSlugs.map(async (slug) => {
    try {
      const data = await reader.collections.writings.read(slug);
      if (!data) return null;
      return { slug, ...data };
    } catch (e) {
      console.error(`[Astro Index SSR] Failed reading writing ${slug}:`, e);
      return null;
    }
  })
);
const recentWritings = writingsRaw
  .filter((post) => post && isArticlePublished(post))
  .sort((a, b) => parsePublishDateTime(b.publishDate, b.publishTime).valueOf() - parsePublishDateTime(a.publishDate, a.publishTime).valueOf())
  .slice(0, 4);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = parsePublishDateTime(dateStr);
  return date.toLocaleDateString('id-ID', {
    timeZone: 'Asia/Jakarta',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout 
  title={siteData.siteTitle || "Wahyudi Setiawan (dvvn) – Multimedia Creator & Visual Storyteller"} 
  description={siteData.siteDescription || "Personal space of Wahyudi Setiawan (dvvn). Multimedia creator focused on visual storytelling, photography, cinematic video, and creative web exploration."}
  image="/itsdvvn-web.jpg"
>
  <!-- 🪶 Featured Quote Section (Serif Font on Clean Card) -->
  {featuredThought && (
    <section class="mb-14 sm:mb-16">
      <div 
        class="relative rounded-2xl p-6 sm:p-8 md:p-10 border transition-all duration-200"
        style="
          background-color: var(--card-bg, #ffffff);
          border-color: var(--border);
          box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        "
      >
        <!-- Large Decorative Quote Mark -->
        <span 
          class="absolute top-3 left-4 sm:top-4 sm:left-6 text-4xl sm:text-5xl select-none pointer-events-none opacity-20 font-serif leading-none"
          style="color: var(--text-primary);"
        >
          “
        </span>

        <!-- Quote Body Content in Serif Italic -->
        <blockquote class="relative z-10 pt-2 sm:pt-3">
          <div 
            class="text-base sm:text-lg md:text-xl leading-relaxed italic text-zinc-800 dark:text-zinc-200 font-serif prose dark:prose-invert max-w-none"
            style="font-family: 'Lora', 'Newsreader', 'Georgia', serif;"
          >
            <Fragment set:html={featuredThought.htmlContent} />
          </div>

          <!-- Reference Link to Thoughts -->
          <div class="mt-5 pt-4 border-t flex items-center justify-between flex-wrap gap-2 text-xs font-mono" style="border-color: var(--border);">
            <div class="flex items-center gap-1.5" style="color: var(--text-muted);">
              {featuredThought.pinned && <span title="Pinned thought">📌</span>}
              <span>{formatDate(featuredThought.publishDate)}</span>
            </div>
            
            <a 
              href="/thoughts" 
              class="inline-flex items-center gap-1 font-semibold hover:underline transition-colors"
              style="color: var(--accent, #007cba);"
            >
              <span>Dikutip dari Thoughts</span>
              <span>↗</span>
            </a>
          </div>
        </blockquote>
      </div>
    </section>
  )}

  <!-- 🚀 Ships & Works Section -->
  <section class="mb-14 sm:mb-16">
    <div class="flex items-center justify-between mb-5">
      <h2 class="section-tag">ships & works</h2>
      <a href="/ships" class="section-tag hover:opacity-80">all works →</a>
    </div>

    <div class="grid grid-cols-1 gap-4">
      {recentShips.map((ship) => (
        <div class="ship-card p-4 sm:p-5 group transition-all duration-200">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-base font-bold tracking-tight">
                <a href={`/ships/${ship.slug}`} class="hover:underline underline-offset-4 inline-flex items-center gap-1.5" style="color: var(--text-primary);">
                  <span>{ship.title}</span>
                  <span class="text-xs opacity-60 group-hover:translate-x-0.5 transition-transform">→</span>
                </a>
              </h3>
              {ship.category && (
                <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border);">
                  {ship.category}
                </span>
              )}
            </div>
            {ship.year && (
              <span class="text-xs font-mono shrink-0" style="color: var(--text-muted);">
                {ship.year}
              </span>
            )}
          </div>

          {(ship.coverImage || ship.coverImageUrl || ship.image) && (
            <a href={`/ships/${ship.slug}`} class="block mb-3 rounded-lg overflow-hidden border max-h-[300px] transition-opacity hover:opacity-95" style="border-color: var(--border);">
              <img 
                src={ship.coverImage || ship.coverImageUrl || ship.image} 
                alt={ship.title} 
                class="w-full h-auto object-cover max-h-[300px]" 
                loading="lazy" 
                decoding="async" 
              />
            </a>
          )}

          <p class="ship-desc mb-3 text-xs sm:text-sm leading-relaxed" style="color: var(--text-secondary);">{ship.description}</p>
          
          <div class="flex items-center justify-between flex-wrap gap-2 pt-2.5 border-t" style="border-color: var(--border);">
            <div class="flex gap-1.5 flex-wrap">
              {(ship.tools || []).map((tool: string) => (
                <span class="tech-tag">
                  {tool}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-3 text-xs font-mono">
              <a href={`/ships/${ship.slug}`} class="hover:underline font-semibold flex items-center gap-1" style="color: var(--accent, #007cba);">
                <span>view case study</span>
                <span>→</span>
              </a>
              {ship.link && (
                <a href={ship.link} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5 opacity-75 hover:opacity-100" style="color: var(--text-primary);">
                  <span>live</span>
                  <span class="text-[10px]">↗</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 📰 Writings Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="section-tag">writings</h2>
      <a href="/writings" class="section-tag hover:opacity-80">all writings →</a>
    </div>

    <div class="divide-y" style="border-color: var(--border);">
      {recentWritings.map((post) => (
        <a href={`/writings/${post.slug}`} class="post-row py-3 block">
          <span class="post-title font-medium inline-flex items-center gap-1.5">
            <span>{post.title}</span>
            {post.isLocked && <span class="text-xs" title="Artikel Terkunci">🔒</span>}
          </span>
          <span class="post-date text-xs font-mono">{formatDate(post.publishDate)}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
