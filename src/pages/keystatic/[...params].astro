---
import KeystaticApp from '../../components/KeystaticApp';

export const prerender = false;
---

<KeystaticApp client:only="react" />

<script is:inline>
  (function() {
    function setupLiveCounters() {
      // 1. Scan semua input teks dan textarea
      const inputs = document.querySelectorAll('input[type="text"], textarea');
      
      inputs.forEach(el => {
        // Cari label terdekat
        const formField = el.closest('[class*="field"], label, div');
        const parentContainer = el.parentElement;
        const allText = (formField?.textContent || '' + ' ' + (el.getAttribute('aria-label') || '') + ' ' + (el.getAttribute('placeholder') || '')).toLowerCase();

        const isTitle = (allText.includes('headline') || allText.includes('judul')) && el.tagName === 'INPUT' && !el.id?.includes('slug');
        const isDeck = (allText.includes('deck') || allText.includes('deskripsi') || allText.includes('subheadline')) && el.tagName === 'TEXTAREA';

        if (isTitle) {
          attachCounter(el, 80, 'Judul');
        } else if (isDeck) {
          attachCounter(el, 144, 'Deskripsi');
        }
      });
    }

    function attachCounter(elem, max, labelName) {
      if (elem.dataset.counterAttached) return;
      elem.dataset.counterAttached = 'true';

      const box = document.createElement('div');
      box.className = 'live-char-counter-box';
      box.style.cssText = 'display:flex; justify-content:space-between; align-items:center; font-size:11px; font-family:monospace; margin-top:4px; padding:3px 8px; border-radius:4px; transition:all 0.15s ease; width:100%; box-sizing:border-box;';

      function update() {
        const len = elem.value.length;
        const remaining = max - len;
        const isOver = len > max;

        box.innerHTML = `
          <span>${labelName}: <strong>${len} / ${max}</strong> karakter</span>
          <span>${isOver ? '⚠️ Lebih ' + Math.abs(remaining) + ' karakter' : 'Sisa ' + remaining + ' karakter'}</span>
        `;

        if (isOver) {
          box.style.color = '#ef4444';
          box.style.backgroundColor = 'rgba(239, 68, 68, 0.12)';
          box.style.border = '1px solid rgba(239, 68, 68, 0.35)';
        } else if (len > max * 0.85) {
          box.style.color = '#f59e0b';
          box.style.backgroundColor = 'rgba(245, 158, 11, 0.1)';
          box.style.border = '1px solid rgba(245, 158, 11, 0.25)';
        } else {
          box.style.color = '#10b981';
          box.style.backgroundColor = 'rgba(16, 185, 129, 0.08)';
          box.style.border = '1px solid rgba(16, 185, 129, 0.2)';
        }
      }

      elem.addEventListener('input', update);
      elem.addEventListener('change', update);
      elem.addEventListener('keyup', update);
      elem.addEventListener('focus', update);
      update();

      // Sisipkan tepat di bawah elemen input
      if (elem.nextSibling) {
        elem.parentNode.insertBefore(box, elem.nextSibling);
      } else {
        elem.parentNode.appendChild(box);
      }
    }

    setInterval(setupLiveCounters, 500);
    window.addEventListener('load', setupLiveCounters);
    document.addEventListener('DOMContentLoaded', setupLiveCounters);
  })();
</script>
