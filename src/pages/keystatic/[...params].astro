---
import KeystaticApp from '../../components/KeystaticApp';

export const prerender = false;
---

<KeystaticApp client:only="react" />

<style is:global>
  .ks-char-counter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    padding: 3px 8px;
    border-radius: 4px;
    margin-top: 6px;
    font-weight: 600;
    width: fit-content;
    transition: all 0.2s ease;
  }
  .ks-char-counter-badge.normal {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  .ks-char-counter-badge.warning {
    background: rgba(245, 158, 11, 0.14);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.35);
  }
  .ks-char-counter-badge.danger {
    background: rgba(239, 68, 68, 0.16);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.4);
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>

<script is:inline>
  (function() {
    function initCounters() {
      // 1. Temukan semua input headline/title dan textarea deck/deskripsi
      const allTextInputs = document.querySelectorAll('input[type="text"], textarea');

      allTextInputs.forEach(input => {
        // Cari container field terdekat
        const container = input.closest('div[class*="css-"], label, [role="group"]') || input.parentElement;
        if (!container) return;

        const containerText = (container.textContent || '' + ' ' + (input.getAttribute('aria-label') || '') + ' ' + (input.placeholder || '')).toLowerCase();
        
        // Identifikasi field
        const isTitleField = (containerText.includes('headline') || containerText.includes('judul')) && input.tagName === 'INPUT' && !input.id?.includes('slug');
        const isDeckField = (containerText.includes('deck') || containerText.includes('deskripsi') || containerText.includes('subheadline')) && input.tagName === 'TEXTAREA';

        if (isTitleField) {
          bindCounter(input, container, 80, 'Judul Artikel');
        } else if (isDeckField) {
          bindCounter(input, container, 144, 'Deskripsi Artikel');
        }
      });
    }

    function bindCounter(input, container, maxChars, fieldName) {
      if (input.dataset.hasLiveCounter) return;
      input.dataset.hasLiveCounter = 'true';

      const badge = document.createElement('div');
      badge.className = 'ks-char-counter-badge normal';

      function render() {
        const count = input.value ? input.value.length : 0;
        const remaining = maxChars - count;
        const isExceeded = count > maxChars;

        badge.className = 'ks-char-counter-badge ' + (isExceeded ? 'danger' : count >= maxChars * 0.85 ? 'warning' : 'normal');
        badge.innerHTML = `
          <span>📊 ${fieldName}: <strong>${count}/${maxChars}</strong> karakter</span>
          <span>•</span>
          <span>${isExceeded ? '⚠️ Kelebihan ' + Math.abs(remaining) + ' karakter' : 'Sisa ' + remaining + ' lagi'}</span>
        `;
      }

      ['input', 'change', 'keyup', 'focus', 'paste'].forEach(evt => {
        input.addEventListener(evt, render);
      });
      render();

      // Tempatkan tepat di bawah wrapper input field
      const fieldWrapper = input.closest('div[class*="css-"]') || input.parentElement;
      if (fieldWrapper && fieldWrapper.parentElement) {
        fieldWrapper.parentElement.appendChild(badge);
      } else {
        input.insertAdjacentElement('afterend', badge);
      }
    }

    setInterval(initCounters, 300);
    window.addEventListener('load', initCounters);
    document.addEventListener('DOMContentLoaded', initCounters);
  })();
</script>
