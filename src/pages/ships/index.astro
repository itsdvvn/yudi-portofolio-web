---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';

const allSlugs = await reader.collections.ships.list();
const shipsRaw = await Promise.all(
  allSlugs.map(async (slug) => {
    const data = await reader.collections.ships.read(slug);
    return { slug, ...data };
  })
);

const ships = shipsRaw
  .filter(Boolean)
  .map((s: any) => {
    const finalCategory = (s.category === 'Custom' && s.customCategory?.trim()) 
      ? s.customCategory.trim() 
      : (s.category || 'General').trim();
    return { ...s, displayCategory: finalCategory };
  })
  .sort((a, b) => (b.year || '').localeCompare(a.year || ''));

// Extract unique categories dynamically from actual items entered by the user
const categoryMap = new Map<string, string>();
for (const ship of ships) {
  const cat = ship.displayCategory;
  if (cat && !categoryMap.has(cat.toLowerCase())) {
    categoryMap.set(cat.toLowerCase(), cat);
  }
}

const dynamicCategories = Array.from(categoryMap.values());
const categories = ['All', ...dynamicCategories];
---

<BaseLayout title="ships & works – dvvn" description="a collection of multimedia works, photography, videos, and code projects">
  <div class="mb-8">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">ships & works</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a collection of creative multimedia works, photography series, videos, and code experiments.</p>
  </div>

  <!-- Interactive Category Filter Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-3 mb-6" id="filter-container">
    {categories.map((cat, idx) => (
      <button 
        data-filter={cat}
        class={`category-tab text-xs font-mono px-3 py-1 rounded border transition-all cursor-pointer ${idx === 0 ? 'active' : ''}`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Works Grid / List -->
  <div class="space-y-4" id="ships-list">
    {ships.map((ship) => (
      <div class="ship-card group transition-all duration-200" data-category={ship.displayCategory}>
        <div class="flex items-start sm:items-center justify-between mb-2.5 gap-3">
          <h2 class="ship-title min-w-0 text-base sm:text-lg font-bold">
            <a href={`/ships/${ship.slug}`} class="hover:underline underline-offset-4 inline-flex items-center gap-1.5 leading-snug" style="color: var(--text-primary);">
              <span>{ship.title}</span>
              <span class="text-xs opacity-60 group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </h2>
          <div class="flex items-center gap-2 shrink-0 self-start sm:self-auto">
            <span class="text-[11px] font-mono" style="color: var(--text-muted);">{ship.year}</span>
            <span class="status-badge">
              {ship.displayCategory}
            </span>
          </div>
        </div>

        {(ship.coverImage || ship.coverImageUrl) && (
          <a href={`/ships/${ship.slug}`} class="block mb-3 rounded-xl overflow-hidden border transition-opacity hover:opacity-95" style="border-color: var(--border);">
            <img 
              src={ship.coverImage || ship.coverImageUrl} 
              alt={ship.title} 
              class="w-full h-48 sm:h-64 object-cover" 
              loading="lazy" 
              decoding="async" 
            />
          </a>
        )}

        <p class="ship-desc mb-3 text-xs sm:text-sm leading-relaxed" style="color: var(--text-secondary);">
          {ship.description}
        </p>

        <div class="flex items-center justify-between flex-wrap gap-2 pt-2.5 border-t" style="border-color: var(--border);">
          <div class="flex gap-1.5 flex-wrap">
            {(ship.tools || []).map((tool) => (
              <span class="tech-tag">
                {tool}
              </span>
            ))}
          </div>

          <div class="flex gap-3 text-xs font-mono items-center">
            <a href={`/ships/${ship.slug}`} class="hover:underline font-semibold flex items-center gap-1" style="color: var(--accent, #007cba);">
              <span>case study</span>
              <span>→</span>
            </a>
            {ship.link && (
              <a href={ship.link} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5 opacity-80 hover:opacity-100" style="color: var(--text-primary);">
                <span>live</span>
                <span class="text-[10px]">↗</span>
              </a>
            )}
            {ship.github && (
              <a href={ship.github} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5 opacity-80 hover:opacity-100" style="color: var(--text-muted);">
                <span>source</span>
                <span class="text-[10px]">↗</span>
              </a>
            )}
            {ship.videoUrl && (
              <a href={ship.videoUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5 opacity-80 hover:opacity-100" style="color: var(--accent);">
                <span>video</span>
                <span class="text-[10px]">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}

    {ships.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No ships or works added yet.</p>
    )}
  </div>
</BaseLayout>

<script is:inline>
  const filterTabs = document.querySelectorAll('.category-tab');
  const cards = document.querySelectorAll('.ship-card');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = (tab.getAttribute('data-filter') || '').toLowerCase();

      cards.forEach((card) => {
        const category = (card.getAttribute('data-category') || '').toLowerCase();
        if (filter === 'all' || category === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
