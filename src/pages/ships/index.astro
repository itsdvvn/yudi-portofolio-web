---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';

const allSlugs = await reader.collections.ships.list();
const shipsRaw = await Promise.all(
  allSlugs.map(async (slug) => {
    const data = await reader.collections.ships.read(slug);
    return { slug, ...data };
  })
);

const ships = shipsRaw
  .filter(Boolean)
  .sort((a, b) => (b.year || '').localeCompare(a.year || ''));

// 1. Get profile master categories
const profileData = await reader.singletons.profile.read();
const masterCategories: string[] = (profileData as any)?.customCategories || [];

// 2. Extract unique categories dynamically from actual items entered by the user
const itemCategories = ships.map((s) => s.category?.trim()).filter(Boolean);

// 3. Merge & Deduplicate case-insensitively while preserving proper title casing
const categoryMap = new Map<string, string>();
for (const cat of [...masterCategories, ...itemCategories]) {
  if (cat && !categoryMap.has(cat.toLowerCase())) {
    categoryMap.set(cat.toLowerCase(), cat);
  }
}

const dynamicCategories = Array.from(categoryMap.values());
const categories = ['All', ...dynamicCategories];
---

<BaseLayout title="ships & works – dvvn" description="a collection of multimedia works, photography, videos, and code projects">
  <div class="mb-8">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">ships & works</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a collection of creative multimedia works, photography series, videos, and code experiments.</p>
  </div>

  <!-- Interactive Category Filter Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-3 mb-6" id="filter-container">
    {categories.map((cat, idx) => (
      <button 
        data-filter={cat}
        class={`category-tab text-xs font-mono px-3 py-1 rounded border transition-all cursor-pointer ${idx === 0 ? 'active' : ''}`}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Works Grid / List -->
  <div class="space-y-4" id="ships-list">
    {ships.map((ship) => (
      <div class="ship-card" data-category={ship.category}>
        <div class="flex items-center justify-between mb-2 gap-2">
          <h2 class="ship-title">
            {ship.link ? (
              <a href={ship.link} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 flex items-center gap-1">
                {ship.title}
                <span style="color: var(--text-muted); font-size: 0.75rem;">↗</span>
              </a>
            ) : (
              ship.title
            )}
          </h2>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-[11px] font-mono" style="color: var(--text-muted);">{ship.year}</span>
            <span class="status-badge">
              {ship.category}
            </span>
          </div>
        </div>

        {(ship.coverImage || ship.coverImageUrl) && (
          <div class="mb-3 rounded overflow-hidden border" style="border-color: var(--border);">
            <img src={ship.coverImage || ship.coverImageUrl} alt={ship.title} class="w-full h-48 sm:h-64 object-cover" />
          </div>
        )}

        <p class="ship-desc mb-3">
          {ship.description}
        </p>

        <div class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t" style="border-color: var(--border);">
          <div class="flex gap-1.5 flex-wrap">
            {(ship.tools || []).map((tool) => (
              <span class="tech-tag">
                {tool}
              </span>
            ))}
          </div>

          <div class="flex gap-3 text-xs font-mono">
            {ship.videoUrl && (
              <a href={ship.videoUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--accent);">
                watch video ↗
              </a>
            )}
            {ship.link && (
              <a href={ship.link} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-primary);">
                view work ↗
              </a>
            )}
            {ship.github && (
              <a href={ship.github} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-0.5" style="color: var(--text-muted);">
                source ↗
              </a>
            )}
          </div>
        </div>
      </div>
    ))}

    {ships.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No ships or works added yet.</p>
    )}
  </div>
</BaseLayout>

<script is:inline>
  const filterTabs = document.querySelectorAll('.category-tab');
  const cards = document.querySelectorAll('.ship-card');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = (tab.getAttribute('data-filter') || '').toLowerCase();

      cards.forEach((card) => {
        const category = (card.getAttribute('data-category') || '').toLowerCase();
        if (filter === 'all' || category === filter) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
