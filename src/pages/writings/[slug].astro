---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';
import { calculateReadingTime } from '../../lib/readingTime';
import Markdoc from '@markdoc/markdoc';
import NewsletterBox from '../../components/NewsletterBox.astro';

const { slug } = Astro.params;
const post = await reader.collections.writings.read(slug as string);

if (!post || post.draft) {
  return Astro.redirect('/writings');
}

const contentAst = await post.content();

const markdocConfig = {
  tags: {
    ArticleImage: {
      render: 'ArticleImage',
      attributes: {
        image: { type: String },
        caption: { type: String },
        credit: { type: String },
      },
      transform(node: any, config: any) {
        const { image, caption, credit } = node.attributes;
        const imgPath = image && !image.startsWith('http') && !image.startsWith('/') 
          ? `/media/body/${image}` 
          : image;

        return new Markdoc.Tag('figure', { 
          class: 'article-figure my-8 w-full block' 
        }, [
          new Markdoc.Tag('img', { 
            src: imgPath, 
            alt: caption || 'Article Image',
            class: 'w-full h-auto object-contain block m-0 p-0 border-0 outline-0 shadow-none bg-transparent',
            loading: 'lazy'
          }),
          (caption || credit) && new Markdoc.Tag('figcaption', { 
            class: 'article-caption text-xs mt-2 text-zinc-400 italic flex flex-col sm:flex-row justify-between gap-1 pb-2 border-b', 
            style: 'border-color: var(--border); font-family: \'Lora\', \'Newsreader\', serif;' 
          }, [
            caption && new Markdoc.Tag('span', { style: 'color: var(--text-secondary);' }, [caption]),
            credit && new Markdoc.Tag('span', { class: 'font-mono text-[11px] not-italic', style: 'color: var(--text-muted);' }, [`Foto/ ${credit}`]),
          ]),
        ].filter(Boolean));
      },
    },
    YouTubeEmbed: {
      render: 'YouTubeEmbed',
      attributes: {
        url: { type: String },
        caption: { type: String },
      },
      transform(node: any) {
        const { url, caption } = node.attributes;
        if (!url) return null;

        let videoId = url.trim();
        if (videoId.includes('v=')) {
          videoId = videoId.split('v=')[1].split('&')[0];
        } else if (videoId.includes('youtu.be/')) {
          videoId = videoId.split('youtu.be/')[1].split('?')[0];
        } else if (videoId.includes('embed/')) {
          videoId = videoId.split('embed/')[1].split('?')[0];
        }

        return new Markdoc.Tag('figure', { class: 'my-8 w-full block' }, [
          new Markdoc.Tag('div', { class: 'relative w-full aspect-video rounded-lg overflow-hidden border shadow-sm', style: 'border-color: var(--border);' }, [
            new Markdoc.Tag('iframe', {
              src: `https://www.youtube-nocookie.com/embed/${videoId}`,
              title: caption || 'YouTube Video Player',
              class: 'absolute top-0 left-0 w-full h-full border-0',
              allow: 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
              allowfullscreen: 'true',
            }),
          ]),
          caption && new Markdoc.Tag('figcaption', { 
            class: 'article-caption text-xs mt-2 text-zinc-400 italic pb-2 border-b', 
            style: 'border-color: var(--border); font-family: \'Lora\', \'Newsreader\', serif;' 
          }, [caption]),
        ].filter(Boolean));
      },
    },
    InstagramEmbed: {
      render: 'InstagramEmbed',
      attributes: {
        url: { type: String },
        caption: { type: String },
      },
      transform(node: any) {
        const { url, caption } = node.attributes;
        if (!url) return null;

        let cleanUrl = url.trim().split('?')[0];
        if (!cleanUrl.endsWith('/')) cleanUrl += '/';
        const embedUrl = `${cleanUrl}embed`;

        return new Markdoc.Tag('figure', { class: 'my-8 max-w-md mx-auto block text-center' }, [
          new Markdoc.Tag('div', { class: 'rounded-lg overflow-hidden border bg-zinc-950/20 shadow-sm flex justify-center', style: 'border-color: var(--border);' }, [
            new Markdoc.Tag('iframe', {
              src: embedUrl,
              class: 'w-full min-h-[480px] max-w-[420px] border-0 mx-auto',
              frameborder: '0',
              scrolling: 'no',
              allowtransparency: 'true',
            }),
          ]),
          caption && new Markdoc.Tag('figcaption', { 
            class: 'article-caption text-xs mt-2 text-zinc-400 italic text-left pb-2 border-b', 
            style: 'border-color: var(--border); font-family: \'Lora\', \'Newsreader\', serif;' 
          }, [caption]),
        ].filter(Boolean));
      },
    },
    SpotifyEmbed: {
      render: 'SpotifyEmbed',
      attributes: {
        url: { type: String },
        caption: { type: String },
      },
      transform(node: any) {
        const { url, caption } = node.attributes;
        if (!url) return null;

        let cleanUrl = url.trim().split('?')[0];
        // Normalize Spotify URL format to /embed/
        let embedSrc = cleanUrl;
        if (cleanUrl.includes('open.spotify.com/')) {
          embedSrc = cleanUrl.replace('open.spotify.com/', 'open.spotify.com/embed/');
        } else if (cleanUrl.startsWith('spotify:')) {
          // URI format: spotify:track:id or spotify:album:id
          const parts = cleanUrl.split(':');
          if (parts.length >= 3) {
            embedSrc = `https://open.spotify.com/embed/${parts[1]}/${parts[2]}`;
          }
        }

        // Determine height based on type (track: 152px, album/playlist: 352px)
        const isTrack = cleanUrl.includes('/track/') || cleanUrl.includes(':track:');
        const height = isTrack ? '152' : '352';

        return new Markdoc.Tag('figure', { class: 'my-8 w-full block' }, [
          new Markdoc.Tag('div', { class: 'rounded-xl overflow-hidden shadow-sm border', style: 'border-color: var(--border);' }, [
            new Markdoc.Tag('iframe', {
              src: embedSrc,
              width: '100%',
              height: height,
              frameborder: '0',
              allowtransparency: 'true',
              allow: 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture',
              loading: 'lazy',
              class: 'w-full block border-0',
            }),
          ]),
          caption && new Markdoc.Tag('figcaption', { 
            class: 'article-caption text-xs mt-2 text-zinc-400 italic pb-2 border-b', 
            style: 'border-color: var(--border); font-family: \'Lora\', \'Newsreader\', serif;' 
          }, [caption]),
        ].filter(Boolean));
      },
    },
  },
};

const transformedContent = Markdoc.transform(contentAst.node || contentAst, markdocConfig);
let rawHtml = Markdoc.renderers.html(transformedContent);

// Fix relative inline images to point to /media/writings/[slug]/ or /media/...
const htmlContent = rawHtml.replace(/<img\s+([^>]*?)src="([^"]+)"/gi, (match, prefix, src) => {
  if (src.startsWith('http') || src.startsWith('/')) {
    return `<img ${prefix}src="${src}"`;
  }
  // If it's a relative filename (e.g. Screenshot.jpg), map to /media/writings/[slug]/filename
  return `<img ${prefix}src="/media/writings/${slug}/${src}"`;
});

const computedReadTime = calculateReadingTime(htmlContent);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const rawHero = post.heroImage || post.heroImageUrl;
let heroImg = rawHero;
if (rawHero && !rawHero.startsWith('http')) {
  heroImg = `${rawHero}?t=${Date.now()}`;
}

// 6. If article belongs to a Weekly Magazine Edition, load the Edition & all sibling articles
let parentEdition: any = null;
let editionArticles: any[] = [];

if (post.publicationType === 'mingguan' && post.edition) {
  parentEdition = await reader.collections.editions.read(post.edition);
  if (parentEdition) {
    const allWritingsSlugs = await reader.collections.writings.list();
    const allWritingsData = await Promise.all(
      allWritingsSlugs.map(async (s) => {
        const item = await reader.collections.writings.read(s);
        return { slug: s, ...item };
      })
    );

    editionArticles = allWritingsData
      .filter((w) => w && !w.draft && w.publicationType === 'mingguan' && w.edition === post.edition)
      .sort((a, b) => {
        const orderA = a.order ?? (a.isCoverStory ? 0 : 99);
        const orderB = b.order ?? (b.isCoverStory ? 0 : 99);
        return orderA - orderB;
      });
  }
}
---

<BaseLayout 
  title={`${post.title} – dvvn`} 
  description={post.deck || post.title}
  image={heroImg || 'https://itsdvvn.my.id/favicon.svg'}
  type="article"
  publishDate={post.publishDate ? new Date(post.publishDate).toISOString() : undefined}
>
    <!-- 1. Breadcrumb / Category -->
    <nav class="flex items-center gap-2 text-xs font-mono mb-4 text-zinc-400 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">home</a>
      <span>/</span>
      <a href={post.publicationType === 'mingguan' ? '/writings#mingguan' : '/writings'} class="hover:underline">
        {post.publicationType === 'mingguan' ? 'majalah mingguan' : 'writings'}
      </a>
      <span>/</span>
      <span class="text-emerald-400 font-semibold">{post.rubrik || post.category || 'Article'}</span>
      {post.isCoverStory && (
        <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-rose-600 text-white uppercase">
          Laporan Utama
        </span>
      )}
    </nav>

    <!-- 2. Headline (H1) -->
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3 leading-tight" style="color: var(--text-primary);">
      {post.title}
    </h1>

    <!-- 3. Deck / Subheadline -->
    {post.deck && (
      <p class="text-base sm:text-lg leading-relaxed mb-4 font-normal" style="color: var(--text-secondary);">
        {post.deck}
      </p>
    )}

    <!-- 4. Publication Date & Time -->
    <div class="flex items-center gap-2 text-xs font-mono mb-6" style="color: var(--text-muted);">
      <span>{formatDate(post.publishDate)}</span>
      <span>•</span>
      <span>{post.publishTime || '10:00 AM'}</span>
      <span>•</span>
      <span>{computedReadTime || post.readTime || '1 min read'}</span>
    </div>

    <!-- 5. Hero / Featured Image Section -->
    {heroImg && (
      <figure class="mb-8 rounded-lg overflow-hidden border" style="border-color: var(--border);">
        <img 
          src={heroImg} 
          alt={post.imageCaption || post.title} 
          class="w-full h-auto max-h-[420px] object-cover" 
          loading="eager"
        />
        {(post.imageCaption || post.photoCredit) && (
          <figcaption class="p-3 bg-zinc-900/30 dark:bg-zinc-900/30 text-xs flex flex-col sm:flex-row justify-between gap-1 border-t" style="border-color: var(--border);">
            {post.imageCaption && (
              <span style="color: var(--text-secondary);">{post.imageCaption}</span>
            )}
            {post.photoCredit && (
              <span class="font-mono text-[11px]" style="color: var(--text-muted);">{post.photoCredit}</span>
            )}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Article Content Divider & Body -->
    <div class="prose text-sm leading-relaxed max-w-none border-t pt-6" style="border-color: var(--border);">
      <Fragment set:html={htmlContent} />
    </div>

    <!-- 📖 Majalah Mingguan Series / Edition Navigation Box (Tempo Style) -->
    {parentEdition && editionArticles.length > 0 && (
      <section class="my-10 rounded-xl overflow-hidden border p-5 sm:p-7 bg-zinc-950 text-white shadow-xl" style="border-color: rgba(255,255,255,0.12);">
        <!-- Edition Header -->
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10">
          <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-600 text-white font-mono tracking-wider uppercase">
            Edisi Khusus
          </span>
          <span class="text-xs font-mono text-zinc-300">
            {parentEdition.editionNumber || formatDate(parentEdition.publishDate)}
          </span>
        </div>

        <!-- Edition Info: Cover + Title + Arrow Link -->
        <div class="flex items-start gap-4 mb-6">
          <div class="w-16 sm:w-20 aspect-[3/4] rounded overflow-hidden bg-zinc-800 shrink-0 border border-white/10 shadow-md">
            <img 
              src={parentEdition.coverImage || parentEdition.coverImageUrl || '/itsdvvn-web.jpg'} 
              alt={parentEdition.title} 
              class="w-full h-full object-cover" 
            />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="text-base sm:text-lg font-bold text-white leading-snug tracking-tight mb-1">
              {parentEdition.title}
            </h3>
            <a 
              href="/writings#mingguan" 
              class="text-xs font-mono text-zinc-400 hover:text-white transition-colors inline-flex items-center gap-1 mt-0.5"
            >
              <span>Lihat Edisi Selengkapnya</span>
              <span class="text-sm">→</span>
            </a>
          </div>
        </div>

        <!-- Article List / Series Playlist in this Edition -->
        <div class="divide-y border-y border-white/10">
          {editionArticles.map((item, idx) => {
            const isCurrent = item.slug === slug;

            return (
              <a 
                href={`/writings/${item.slug}`} 
                class={`py-3 sm:py-3.5 flex items-start gap-3 transition-colors block group ${
                  isCurrent 
                    ? 'text-rose-400 font-semibold' 
                    : 'text-zinc-200 hover:text-white hover:bg-white/[0.02]'
                }`}
              >
                <!-- Active / Current Indicator Arrow -->
                <div class="w-5 shrink-0 pt-0.5 text-center">
                  {isCurrent ? (
                    <span class="text-rose-500 font-bold text-sm">→</span>
                  ) : (
                    <span class="text-zinc-600 font-mono text-xs group-hover:text-zinc-400">{idx + 1}</span>
                  )}
                </div>

                <!-- Article Rubrik & Title -->
                <div class="min-w-0 flex-1">
                  {item.rubrik && (
                    <span class={`text-[10px] font-mono uppercase tracking-wider block mb-0.5 ${
                      isCurrent ? 'text-rose-400' : 'text-zinc-400 group-hover:text-zinc-300'
                    }`}>
                      {item.rubrik}
                    </span>
                  )}
                  <h4 class={`text-xs sm:text-sm leading-snug transition-colors ${
                    isCurrent ? 'text-rose-400 font-bold' : 'text-zinc-100 group-hover:text-white'
                  }`}>
                    {item.title}
                  </h4>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Newsletter Subscription Box -->
    <NewsletterBox articleTitle={post.title} />
  </article>
</BaseLayout>
