---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';
import Markdoc from '@markdoc/markdoc';

const { slug } = Astro.params;
const post = await reader.collections.writings.read(slug as string);

if (!post || post.draft) {
  return Astro.redirect('/writings');
}

const contentAst = await post.content();
const transformedContent = Markdoc.transform(contentAst.node || contentAst);
const htmlContent = Markdoc.renderers.html(transformedContent);

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const rawHero = post.heroImage || post.heroImageUrl;
let heroImg = rawHero;
if (rawHero && !rawHero.startsWith('http')) {
  heroImg = `${rawHero}?t=${Date.now()}`;
}
---

<BaseLayout title={`${post.title} – dvvn`} description={post.deck || post.title}>
  <article class="max-w-none">
    <!-- 1. Breadcrumb / Category -->
    <nav class="flex items-center gap-2 text-xs font-mono mb-4 text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">home</a>
      <span>/</span>
      <a href="/writings" class="hover:underline">writings</a>
      <span>/</span>
      <span class="text-zinc-500">{post.category || 'Article'}</span>
    </nav>

    <!-- 2. Headline (H1) -->
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3 leading-tight" style="color: var(--text-primary);">
      {post.title}
    </h1>

    <!-- 3. Deck / Subheadline -->
    {post.deck && (
      <p class="text-base sm:text-lg leading-relaxed mb-4 font-normal" style="color: var(--text-secondary);">
        {post.deck}
      </p>
    )}

    <!-- 4. Publication Date & Time -->
    <div class="flex items-center gap-2 text-xs font-mono mb-6" style="color: var(--text-muted);">
      <span>{formatDate(post.publishDate)}</span>
      <span>•</span>
      <span>{post.publishTime || '10:00 AM'}</span>
      <span>•</span>
      <span>{post.readTime || '3 min read'}</span>
    </div>

    <!-- 5. Hero / Featured Image Section -->
    {heroImg && (
      <figure class="mb-8 rounded-lg overflow-hidden border" style="border-color: var(--border);">
        <img 
          src={`${heroImg}${heroImg.startsWith('http') ? '' : `?v=${Date.now()}`}`} 
          alt={post.imageCaption || post.title} 
          class="w-full h-auto max-h-[420px] object-cover" 
          loading="eager"
        />
        {(post.imageCaption || post.photoCredit) && (
          <figcaption class="p-3 bg-zinc-900/30 dark:bg-zinc-900/30 text-xs flex flex-col sm:flex-row justify-between gap-1 border-t" style="border-color: var(--border);">
            {post.imageCaption && (
              <span style="color: var(--text-secondary);">{post.imageCaption}</span>
            )}
            {post.photoCredit && (
              <span class="font-mono text-[11px]" style="color: var(--text-muted);">{post.photoCredit}</span>
            )}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Article Content Divider & Body -->
    <div class="prose text-sm leading-relaxed max-w-none border-t pt-6" style="border-color: var(--border);">
      <Fragment set:html={htmlContent} />
    </div>
  </article>
</BaseLayout>
