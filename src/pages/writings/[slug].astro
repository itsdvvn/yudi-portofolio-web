---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';
import { calculateReadingTime } from '../../lib/readingTime';
import { isArticlePublished, parsePublishDateTime } from '../../lib/schedule';
import { renderWritingHtml, type CitationItem } from '../../lib/markdocWriting';
import NewsletterBox from '../../components/NewsletterBox.astro';

const { slug } = Astro.params;
let post = null;
try {
  post = await reader.collections.writings.read(slug as string);
} catch (e) {
  console.error(`[Astro Slug SSR] Failed reading writing ${slug}:`, e);
  return Astro.redirect('/writings');
}

if (!post) {
  return Astro.redirect('/writings');
}

const pubType = typeof post.publicationType === 'object' && post.publicationType !== null 
  ? post.publicationType.discriminant 
  : (post.publicationType || 'reguler');

const editionSlug = typeof post.publicationType === 'object' && post.publicationType?.value?.edition 
  ? post.publicationType.value.edition 
  : (post as any).edition;

let parentEdition = null;
if (pubType === 'mingguan' && editionSlug) {
  try {
    parentEdition = await reader.collections.editions.read(editionSlug);
  } catch (e) {
    parentEdition = null;
  }
}

// Resolusi nama rubrik/kategori dari database rubrics jika bertindak sebagai relationship slug
const rawCategory = post.category;
const rawMingguanRubrik = typeof post.publicationType === 'object' && post.publicationType?.value?.rubrik 
  ? post.publicationType.value.rubrik 
  : (post as any).rubrik;

let displayRubrik = 'Artikel';
const rubricKey = pubType === 'mingguan' ? (rawMingguanRubrik || rawCategory) : rawCategory;

if (rubricKey) {
  try {
    const rubricData = await (reader.collections as any).rubrics?.read(rubricKey);
    displayRubrik = rubricData?.name || rubricKey;
  } catch (e) {
    displayRubrik = rubricKey;
  }
}

if (!isArticlePublished(post, parentEdition)) {
  return Astro.redirect('/writings');
}

const isLocked = !!(post as any).isLocked;
const passwordClue = (post as any).passwordClue || '';

let htmlContent = '';
let collectedCitations: CitationItem[] = [];
let computedReadTime = (post as any).readTime || '3 min read';

if (!isLocked) {
  const contentAst = await post.content();
  const rendered = renderWritingHtml(contentAst, slug as string);
  htmlContent = rendered.htmlContent;
  collectedCitations = rendered.citations;
  computedReadTime = calculateReadingTime(htmlContent);
}

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = parsePublishDateTime(dateStr);
  return date.toLocaleDateString('id-ID', {
    timeZone: 'Asia/Jakarta',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const rawHero = post.heroImage || post.heroImageUrl;
let heroImg = rawHero;
if (rawHero && !rawHero.startsWith('http')) {
  heroImg = `${rawHero}?t=${Date.now()}`;
}

const postRubrik = typeof post.publicationType === 'object' && post.publicationType?.value?.rubrik 
  ? post.publicationType.value.rubrik 
  : (post.rubrik || 'Artikel');

const isCoverStory = typeof post.publicationType === 'object' && post.publicationType?.value?.isCoverStory !== undefined 
  ? post.publicationType.value.isCoverStory 
  : !!post.isCoverStory;

// 6. If article belongs to a Weekly Magazine Edition, load all sibling articles
let editionArticles: any[] = [];

if (pubType === 'mingguan' && editionSlug) {
  if (!parentEdition) {
    try {
      parentEdition = await reader.collections.editions.read(editionSlug);
    } catch (e) {
      parentEdition = null;
    }
  }
  if (parentEdition) {
    const allWritingsSlugs = await reader.collections.writings.list();
    const allWritingsData = await Promise.all(
      allWritingsSlugs.map(async (s) => {
        const item = await reader.collections.writings.read(s);
        if (!item) return null;
        const itemPubType = typeof item.publicationType === 'object' && item.publicationType !== null 
          ? item.publicationType.discriminant 
          : (item.publicationType || 'reguler');
        const itemEdition = typeof item.publicationType === 'object' && item.publicationType?.value?.edition 
          ? item.publicationType.value.edition 
          : item.edition;
        const itemRubrik = typeof item.publicationType === 'object' && item.publicationType?.value?.rubrik 
          ? item.publicationType.value.rubrik 
          : (item.rubrik || 'Artikel');
        const itemOrder = typeof item.publicationType === 'object' && item.publicationType?.value?.order !== undefined 
          ? item.publicationType.value.order 
          : (item.order ?? 1);
        const itemIsCoverStory = typeof item.publicationType === 'object' && item.publicationType?.value?.isCoverStory !== undefined 
          ? item.publicationType.value.isCoverStory 
          : !!item.isCoverStory;

        return { 
          slug: s, 
          ...item, 
          publicationType: itemPubType, 
          edition: itemEdition, 
          rubrik: itemRubrik, 
          order: itemOrder, 
          isCoverStory: itemIsCoverStory 
        };
      })
    );

    editionArticles = allWritingsData
      .filter((w) => w && !w.draft && w.publicationType === 'mingguan' && w.edition === editionSlug)
      .sort((a, b) => {
        const orderA = a.order ?? (a.isCoverStory ? 0 : 99);
        const orderB = b.order ?? (b.isCoverStory ? 0 : 99);
        return orderA - orderB;
      });
  }
}
---

<BaseLayout 
  title={`${post.title} – dvvn`} 
  description={post.deck || post.title}
  image={heroImg || 'https://itsdvvn.my.id/favicon.svg'}
  type="article"
  publishDate={post.publishDate ? new Date(post.publishDate).toISOString() : undefined}
  updatedDate={post.updatedDate ? new Date(post.updatedDate).toISOString() : undefined}
>
    <!-- 1. Breadcrumb / Category -->
    <nav class="flex items-center gap-2 text-xs font-mono mb-4 text-zinc-400 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">home</a>
      <span>/</span>
      <a href={pubType === 'mingguan' ? '/writings#mingguan' : '/writings'} class="hover:underline">
        {pubType === 'mingguan' ? 'majalah mingguan' : 'writings'}
      </a>
      <span>/</span>
      <span class="text-emerald-400 font-semibold">{displayRubrik}</span>
      {isCoverStory && (
        <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-rose-600 text-white uppercase">
          Laporan Utama
        </span>
      )}
    </nav>

    <!-- 2. Headline (H1) -->
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3 leading-tight" style="color: var(--text-primary);">
      {post.title}
    </h1>

    <!-- 3. Deck / Subheadline -->
    {post.deck && (
      <p class="text-base sm:text-lg leading-relaxed mb-4 font-normal" style="color: var(--text-secondary);">
        {post.deck}
      </p>
    )}

    <!-- 4. Publication Date, Updated Date & Read Time -->
    <div class="flex items-center flex-wrap gap-2 text-xs font-mono mb-6" style="color: var(--text-muted);">
      <span>Diterbitkan: {formatDate(post.publishDate)}</span>
      {post.updatedDate && (
        <>
          <span>•</span>
          <span class="text-amber-500/90 dark:text-amber-400/90 font-medium">
            Diperbarui: {formatDate(post.updatedDate)}{post.updatedTime ? `, ${post.updatedTime} WIB` : ''}
          </span>
        </>
      )}
      <span>•</span>
      <span>{computedReadTime || post.readTime || '1 min read'}</span>
      {isLocked && (
        <>
          <span>•</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-500 border border-amber-500/20">
            🔒 Terkunci
          </span>
        </>
      )}
    </div>

    <!-- 5. Hero / Featured Image Section -->
    {heroImg && (
      <figure class="mb-8 rounded-lg overflow-hidden border" style="border-color: var(--border);">
        <img 
          src={heroImg} 
          alt={post.imageCaption || post.title} 
          class="w-full h-auto max-h-[420px] object-cover" 
          loading="eager"
        />
        {(post.imageCaption || post.photoCredit) && (
          <figcaption class="p-3 bg-zinc-900/30 dark:bg-zinc-900/30 text-xs flex flex-col sm:flex-row justify-between gap-1 border-t" style="border-color: var(--border);">
            {post.imageCaption && (
              <span style="color: var(--text-secondary);">{post.imageCaption}</span>
            )}
            {post.photoCredit && (
              <span class="font-mono text-[11px]" style="color: var(--text-muted);">{post.photoCredit}</span>
            )}
          </figcaption>
        )}
      </figure>
    )}
        <!-- Article Content Divider & Body / Lock Gatekeeper -->
    {isLocked ? (
      <div 
        id="article-lock-gate" 
        class="my-8 p-6 sm:p-8 rounded-2xl border text-center shadow-lg transition-all duration-300"
        style="background: var(--card-bg); border-color: var(--border); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);"
      >
        <div class="w-12 h-12 mx-auto rounded-full flex items-center justify-center text-2xl mb-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500">
          <span id="lock-icon" class="transition-transform duration-300">🔒</span>
        </div>
        <h2 class="text-lg sm:text-xl font-bold mb-1.5" style="color: var(--text-primary);">
          Artikel Ini Terkunci
        </h2>
        <p class="text-xs sm:text-sm max-w-md mx-auto mb-4 leading-relaxed" style="color: var(--text-secondary);">
          Tulisan ini diproteksi kata sandi. Masukkan kata sandi yang sesuai untuk membaca seluruh isi artikel.
        </p>

        {passwordClue && (
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono mb-5 border max-w-md" style="background: rgba(255, 255, 255, 0.03); border-color: var(--border); color: var(--text-secondary);">
            <span class="shrink-0">💡</span>
            <span class="text-zinc-500 dark:text-zinc-400">Petunjuk (Clue):</span>
            <strong class="text-emerald-500 font-semibold">{passwordClue}</strong>
          </div>
        )}

        <form id="unlock-article-form" class="max-w-sm mx-auto flex flex-col gap-2.5">
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="unlock-password-input"
              name="password"
              placeholder="Ketik kata sandi di sini..."
              autocomplete="off"
              required
              class="flex-1 px-3.5 py-2 rounded-lg text-xs sm:text-sm font-mono border focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
              style="background: var(--bg); border-color: var(--border); color: var(--text-primary);"
            />
            <button
              type="submit"
              id="unlock-submit-btn"
              class="px-4 py-2 rounded-lg text-xs sm:text-sm font-mono font-semibold bg-emerald-500 hover:bg-emerald-600 dark:hover:bg-emerald-400 text-white dark:text-zinc-950 transition-all shadow-sm active:scale-95 cursor-pointer shrink-0"
            >
              Buka 🔓
            </button>
          </div>
          <div id="unlock-error-msg" class="text-xs font-mono text-rose-500 hidden text-left px-1"></div>
        </form>
      </div>
      <div id="article-body-container" class="prose text-sm leading-relaxed max-w-none border-t pt-6 hidden transition-opacity duration-500" style="border-color: var(--border);"></div>
    ) : (
      <div id="article-body-container" class="prose text-sm leading-relaxed max-w-none border-t pt-6" style="border-color: var(--border);">
        <Fragment set:html={htmlContent} />
      </div>
    )}

    <!-- 📚 Catatan & Referensi Section (Otomatis Render jika ada sitasi) -->
    <div id="references-container">
      {collectedCitations.length > 0 && (
        <section id="references-section" class="my-10 pt-6 border-t" style="border-color: var(--border);">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5 font-mono">
              <span>📚</span>
              <span>Catatan & Referensi</span>
            </span>
            <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 font-semibold">({collectedCitations.length})</span>
          </div>

          <ol class="space-y-3 pl-0 list-none">
            {collectedCitations.map((cite) => (
              <li id={`citation-entry-${cite.id}`} class="text-xs leading-relaxed text-zinc-800 dark:text-zinc-200 flex items-start gap-2.5 p-2.5 rounded-lg transition-colors hover:bg-black/[0.03] dark:hover:bg-white/[0.03] border border-transparent">
                <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold shrink-0 pt-0.5 select-none text-xs">
                  [{cite.id}]
                </span>
                <div class="min-w-0 flex-1">
                  <div class="font-semibold text-zinc-900 dark:text-zinc-100">
                    {cite.source}
                    {cite.year && <span class="text-zinc-600 dark:text-zinc-400 font-mono text-[11px]"> ({cite.year})</span>}
                  </div>
                  {cite.author && (
                    <div class="text-zinc-600 dark:text-zinc-400 text-[11px] mt-0.5 font-medium">
                      {cite.author}
                    </div>
                  )}
                  {cite.note && (
                    <div class="text-zinc-700 dark:text-zinc-300 italic text-[11px] mt-1 pl-2.5 border-l-2 border-emerald-500/40">
                      "{cite.note}"
                    </div>
                  )}
                  <div class="flex items-center gap-3.5 mt-2 text-[11px] font-mono font-medium">
                    {cite.url && (
                      <a 
                        href={cite.url} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 hover:underline inline-flex items-center gap-1"
                      >
                        <span>Buka Sumber</span>
                        <span>↗</span>
                      </a>
                    )}
                    <a 
                      href={`#cite-ref-${cite.id}`} 
                      class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
                      title="Kembali ke paragraf"
                    >
                      ↑ Kembali ke teks
                    </a>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <!-- 📖 Majalah Mingguan Series / Edition Navigation Box (Tempo Style) -->
    {parentEdition && editionArticles.length > 0 && (
      <section class="my-10 rounded-xl overflow-hidden border p-5 sm:p-7 bg-zinc-950 text-white shadow-xl" style="border-color: var(--border);">
        <!-- Edition Header -->
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10">
          <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-600 text-white font-mono tracking-wider uppercase">
            Edisi Khusus
          </span>
          <span class="text-xs font-mono text-zinc-300">
            {parentEdition.editionNumber || formatDate(parentEdition.publishDate)}
          </span>
        </div>

        <!-- Edition Info: Cover + Title + Arrow Link -->
        <div class="flex items-start gap-4 mb-6">
          <div class="w-16 sm:w-20 aspect-[3/4] rounded overflow-hidden bg-zinc-800 shrink-0 border border-white/10 shadow-md">
            <img 
              src={parentEdition.coverImage || parentEdition.coverImageUrl || '/itsdvvn-web.jpg'} 
              alt={parentEdition.title} 
              class="w-full h-full object-cover" 
              loading="lazy" 
            />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="text-lg sm:text-xl font-extrabold text-white leading-snug mb-2">
              {parentEdition.title}
            </h3>
            {parentEdition.summary && (
              <p class="text-xs sm:text-sm text-zinc-400 line-clamp-3 leading-relaxed mb-3">
                {parentEdition.summary}
              </p>
            )}
            <a 
              href={`/editions/${parentEdition.slug}`} 
              class="inline-flex items-center gap-1.5 text-xs font-mono text-emerald-400 hover:text-emerald-300 font-semibold hover:underline"
            >
              <span>Jelajahi Edisi Lengkap</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Article List in this Edition -->
        <div class="border-t border-white/10 pt-4">
          <div class="text-xs font-mono text-zinc-400 mb-3 uppercase tracking-wider font-semibold">
            Daftar Rubrik & Laporan Edisi Ini:
          </div>
          <div class="space-y-2.5">
            {editionArticles.map((art: any) => {
              const isCurrent = art.slug === slug;
              const artRubrik = rubricsMap.get(art.rubrik) || art.rubrik || 'Artikel';
              return (
                <a 
                  href={`/writings/${art.slug}`}
                  class={`flex items-start justify-between gap-3 p-2.5 sm:p-3 rounded-lg transition-all border ${
                    isCurrent 
                      ? 'bg-white/10 border-emerald-500/60 shadow-sm' 
                      : 'hover:bg-white/5 border-transparent hover:border-white/10'
                  }`}
                >
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700">
                        {artRubrik}
                      </span>
                      {art.isCoverStory && (
                        <span class="text-[10px] font-mono text-rose-400 font-bold">
                          ★ Liputan Utama
                        </span>
                      )}
                    </div>
                    <h4 class={`text-sm font-semibold leading-snug line-clamp-2 ${isCurrent ? 'text-emerald-400' : 'text-zinc-200'}`}>
                      {art.title}
                    </h4>
                  </div>
                  <div class="shrink-0 flex items-center text-zinc-400 text-xs font-mono">
                    {isCurrent ? (
                      <span class="text-emerald-400 text-xs font-bold font-mono">Sedang Dibaca</span>
                    ) : (
                      <span>Baca →</span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 6. Share & Actions Footer -->
    <div class="mt-8 pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono" style="border-color: var(--border); color: var(--text-muted);">
      <div class="flex items-center gap-2">
        <span>Bagikan tulisan ini:</span>
        <a 
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(`https://itsdvvn.my.id/writings/${slug}`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 rounded hover:text-zinc-100 transition-colors"
          title="Share to X"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
        </a>
        <button 
          id="copy-link-btn"
          class="p-1.5 rounded hover:text-zinc-100 transition-colors"
          title="Salin tautan"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
        </button>
      </div>

      <a href="/writings" class="hover:underline flex items-center gap-1">
        <span>←</span>
        <span>Kembali ke daftar tulisan</span>
      </a>
    </div>

    <!-- 7. Author Bio Card -->
    <div class="mt-8 p-4 sm:p-5 rounded-xl border flex items-center gap-4" style="background: rgba(255,255,255,0.02); border-color: var(--border);">
      <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 border" style="border-color: var(--border);">
        <img 
          src={avatarImg} 
          alt={authorName} 
          class="w-full h-full object-cover" 
          loading="lazy"
        />
      </div>
      <div class="min-w-0 flex-1">
        <h4 class="text-sm font-semibold" style="color: var(--text-primary);">
          {authorName}
        </h4>
        <p class="text-xs mt-0.5 line-clamp-2" style="color: var(--text-muted);">
          {profileBio}
        </p>
      </div>
    </div>

    <!-- 8. Newsletter / Weekly Magazine Subscription Box -->
    <NewsletterBox />
  </article>

  <!-- Interactive Citation Popover Tooltip Element -->
  <div 
    id="citation-popover" 
    class="fixed hidden z-50 max-w-xs sm:max-w-sm rounded-xl p-3.5 text-left border shadow-2xl backdrop-blur-md bg-white/95 dark:bg-zinc-950/95 text-zinc-900 dark:text-white transition-all duration-150 pointer-events-auto"
    style="border-color: var(--border);"
    role="tooltip"
  >
    <div id="citation-popover-content"></div>
  </div>

  <script is:inline define:vars={{ slug, isLocked }}>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Copy Link Button
      const copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href);
          const orig = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-[10px] text-emerald-400 font-mono">Tersalin!</span>';
          setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
        });
      }

      // 2. Citation Popover Logic Helper
      function setupCitationPopovers() {
        const popover = document.getElementById('citation-popover');
        const popoverContent = document.getElementById('citation-popover-content');
        const triggers = document.querySelectorAll('.citation-sup');
        if (!popover || !popoverContent) return;

        let currentActiveTrigger = null;
        let hideTimeout = null;

        function showPopover(trigger) {
          clearTimeout(hideTimeout);
          currentActiveTrigger = trigger;
          const rawData = trigger.getAttribute('data-citation');
          if (!rawData) return;

          try {
            const data = JSON.parse(decodeURIComponent(rawData));
            popoverContent.innerHTML = `
              <div class="flex items-start justify-between gap-2 mb-1.5 pb-1 border-b" style="border-color: var(--border);">
                <span class="font-mono text-[11px] text-emerald-600 dark:text-emerald-400 font-bold tracking-wider uppercase">Referensi [${data.id}]</span>
                <a href="#citation-entry-${data.id}" class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Lihat di daftar ↓</a>
              </div>
              <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 leading-snug mb-0.5">${data.source}</div>
              ${data.author ? `<div class="text-[11px] text-zinc-600 dark:text-zinc-400 mb-1 font-medium">${data.author}${data.year ? ` (${data.year})` : ''}</div>` : ''}
              ${data.note ? `<div class="text-[11px] text-zinc-700 dark:text-zinc-300 italic mb-2 pl-2 border-l-2 border-emerald-500/40">"${data.note}"</div>` : ''}
              ${data.url ? `
                <a href="${data.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 hover:underline font-mono mt-1 font-medium">
                  <span>Buka Tautan Sumber</span>
                  <span>↗</span>
                </a>
              ` : ''}
            `;

            popover.classList.remove('hidden');

            const rect = trigger.getBoundingClientRect();
            let top = rect.bottom + window.scrollY + 8;
            let left = rect.left + window.scrollX - 20;

            if (left + 320 > window.innerWidth) {
              left = window.innerWidth - 340;
            }
            if (left < 10) left = 10;

            popover.style.top = `${top}px`;
            popover.style.left = `${left}px`;
          } catch (e) {}
        }

        function scheduleHide() {
          hideTimeout = setTimeout(() => {
            popover.classList.add('hidden');
            currentActiveTrigger = null;
          }, 250);
        }

        triggers.forEach(trigger => {
          trigger.addEventListener('mouseenter', () => showPopover(trigger));
          trigger.addEventListener('mouseleave', scheduleHide);

          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            if (currentActiveTrigger === trigger && !popover.classList.contains('hidden')) {
              const citeId = trigger.getAttribute('data-id');
              const targetEl = document.getElementById(`citation-entry-${citeId}`);
              if (targetEl) {
                popover.classList.add('hidden');
                targetEl.scrollIntoView({ behavior: 'smooth' });
                targetEl.classList.add('bg-emerald-500/20');
                setTimeout(() => targetEl.classList.remove('bg-emerald-500/20'), 2000);
              }
            } else {
              showPopover(trigger);
            }
          });
        });

        popover.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
        popover.addEventListener('mouseleave', scheduleHide);

        document.addEventListener('click', (e) => {
          if (!popover.contains(e.target) && !e.target.classList.contains('citation-sup')) {
            popover.classList.add('hidden');
          }
        });
      }

      setupCitationPopovers();

      // 3. Password Protected Article Unlock Logic
      if (isLocked) {
        const lockGate = document.getElementById('article-lock-gate');
        const bodyContainer = document.getElementById('article-body-container');
        const unlockForm = document.getElementById('unlock-article-form');
        const passwordInput = document.getElementById('unlock-password-input');
        const submitBtn = document.getElementById('unlock-submit-btn');
        const errorMsg = document.getElementById('unlock-error-msg');
        const lockIcon = document.getElementById('lock-icon');

        async function performUnlock(password) {
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerText = 'Membuka…';
          }
          if (errorMsg) errorMsg.classList.add('hidden');

          try {
            const res = await fetch('/api/writings/unlock', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, password }),
            });

            const data = await res.json();

            if (res.ok && data.success) {
              // Simpan di session agar tidak perlu isi ulang saat refresh
              sessionStorage.setItem('unlocked_art_' + slug, password);

              if (lockIcon) lockIcon.innerText = '🔓';

              setTimeout(() => {
                if (lockGate) lockGate.classList.add('hidden');
                if (bodyContainer) {
                  bodyContainer.innerHTML = data.htmlContent;
                  bodyContainer.classList.remove('hidden');
                  bodyContainer.classList.add('opacity-100');
                }
                setupCitationPopovers();
              }, 300);
            } else {
              if (errorMsg) {
                errorMsg.innerText = data.error || 'Kata sandi salah. Coba lagi.';
                errorMsg.classList.remove('hidden');
              }
              if (passwordInput) {
                passwordInput.classList.add('border-rose-500', 'animate-shake');
                setTimeout(() => passwordInput.classList.remove('border-rose-500', 'animate-shake'), 1000);
                passwordInput.focus();
              }
            }
          } catch (e) {
            if (errorMsg) {
              errorMsg.innerText = 'Gagal menghubungi server. Periksa koneksi internet Anda.';
              errorMsg.classList.remove('hidden');
            }
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerText = 'Buka 🔓';
            }
          }
        }

        // Cek apakah sudah pernah di-unlock dalam sesi ini
        const savedPw = sessionStorage.getItem('unlocked_art_' + slug);
        if (savedPw) {
          performUnlock(savedPw);
        }

        if (unlockForm) {
          unlockForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const pw = passwordInput ? passwordInput.value : '';
            performUnlock(pw);
          });
        }
      }
    });
  </script>
</BaseLayout>
