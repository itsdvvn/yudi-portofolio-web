---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';
import { calculateReadingTime } from '../../lib/readingTime';
import Markdoc from '@markdoc/markdoc';

const allSlugs = await reader.collections.writings.list();
const writingsRaw = await Promise.all(
  allSlugs.map(async (slug) => {
    const data = await reader.collections.writings.read(slug);
    if (!data) return null;
    let readTime = data.readTime;
    try {
      const contentAst = await data.content();
      const transformedContent = Markdoc.transform(contentAst.node || contentAst);
      const htmlContent = Markdoc.renderers.html(transformedContent);
      readTime = calculateReadingTime(htmlContent);
    } catch (e) {}
    return { slug, ...data, readTime };
  })
);

const writings = writingsRaw
  .filter((post) => post && !post.draft)
  .sort((a, b) => new Date(b.publishDate || 0).valueOf() - new Date(a.publishDate || 0).valueOf());

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="writings – dvvn" description="a collection of my blog posts and articles">
  <div class="mb-10">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">writings</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a collection of my blog posts, notes, and technical articles.</p>
  </div>

  <div class="space-y-4">
    {writings.map((post) => {
      const rawHero = post.heroImage || post.heroImageUrl;
      const heroThumb = rawHero ? (rawHero.startsWith('http') ? rawHero : `${rawHero}?t=${Date.now()}`) : '';

      return (
        <a 
          href={`/writings/${post.slug}`} 
          class="ship-card p-3.5 sm:p-4 flex flex-col sm:flex-row gap-4 items-start group hover:border-zinc-500 transition-all block"
        >
          {heroThumb && (
            <div class="w-full sm:w-36 sm:h-24 h-44 rounded-md overflow-hidden bg-zinc-900 shrink-0 border" style="border-color: var(--border);">
              <img 
                src={heroThumb} 
                alt={post.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                loading="lazy" 
              />
            </div>
          )}
          <div class="flex-1 flex flex-col justify-between min-w-0 w-full">
            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-500 font-medium">
                  {post.category || 'Article'}
                </span>
                <span class="post-date text-[11px] font-mono shrink-0">
                  {formatDate(post.publishDate)}
                </span>
              </div>
              <h2 class="text-base sm:text-base font-semibold group-hover:text-emerald-400 transition-colors leading-snug mb-1.5" style="color: var(--text-primary);">
                {post.title}
              </h2>
              {post.deck && (
                <p class="text-xs sm:text-xs leading-relaxed line-clamp-2" style="color: var(--text-secondary);">
                  {post.deck}
                </p>
              )}
            </div>
            <div class="flex items-center gap-3 text-[11px] font-mono mt-3 pt-2 border-t" style="border-color: var(--border); color: var(--text-muted);">
              <span>{post.readTime || '3 min read'}</span>
              <span>•</span>
              <span class="group-hover:translate-x-0.5 transition-transform text-emerald-400">read article →</span>
            </div>
          </div>
        </a>
      );
    })}

    {writings.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No writings published yet.</p>
    )}
  </div>
</BaseLayout>
