---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';

const allSlugs = await reader.collections.writings.list();
const writingsRaw = await Promise.all(
  allSlugs.map(async (slug) => {
    const data = await reader.collections.writings.read(slug);
    return { slug, ...data };
  })
);

const writings = writingsRaw
  .filter((post) => post && !post.draft)
  .sort((a, b) => new Date(b.publishDate || 0).valueOf() - new Date(a.publishDate || 0).valueOf());

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="writings – dvvn" description="a collection of my blog posts and articles">
  <div class="mb-10">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">writings</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a collection of my blog posts, notes, and technical articles.</p>
  </div>

  <div class="space-y-1">
    {writings.map((post) => (
      <a href={`/writings/${post.slug}`} class="post-row group">
        <div>
          <div class="post-title">{post.title}</div>
          {post.deck && <div class="post-desc">{post.deck}</div>}
        </div>
        <span class="post-date">{formatDate(post.publishDate)}</span>
      </a>
    ))}

    {writings.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No writings published yet.</p>
    )}
  </div>
</BaseLayout>
