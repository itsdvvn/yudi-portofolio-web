---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const writings = (await getCollection('writings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="writings – yudi.sh" description="a collection of my blog posts and articles">
  <div class="mb-10">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">writings</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a collection of my blog posts, notes, and technical articles.</p>
  </div>

  <div class="space-y-1">
    {writings.map((post) => (
      <a href={`/writings/${post.slug}`} class="post-row group">
        <div>
          <div class="post-title">{post.data.title}</div>
          <div class="post-desc">{post.data.description}</div>
        </div>
        <span class="post-date">{formatDate(post.data.publishDate)}</span>
      </a>
    ))}

    {writings.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No writings published yet.</p>
    )}
  </div>
</BaseLayout>
