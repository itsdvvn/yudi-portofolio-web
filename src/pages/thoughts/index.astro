---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/reader';
import Markdoc from '@markdoc/markdoc';

const allSlugs = await reader.collections.thoughts.list();
const thoughtsRaw = await Promise.all(
  allSlugs.map(async (slug) => {
    const data = await reader.collections.thoughts.read(slug);
    if (!data) return null;
    let htmlContent = '';
    try {
      const contentAst = await data.content();
      const transformedContent = Markdoc.transform(contentAst.node || contentAst);
      htmlContent = Markdoc.renderers.html(transformedContent);
    } catch (e) {}
    return { slug, ...data, htmlContent };
  })
);

const thoughts = thoughtsRaw
  .filter(Boolean)
  .sort((a, b) => {
    // 1. Pinned thoughts always come first
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    // 2. Then sort by latest date
    return new Date(b.publishDate || 0).valueOf() - new Date(a.publishDate || 0).valueOf();
  });

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout title="thoughts – dvvn" description="a place for me to share my random thoughts and ideas">
  <div class="mb-10">
    <h1 class="text-xl font-semibold mb-2 tracking-tight" style="color: var(--text-primary);">thoughts</h1>
    <p class="text-sm" style="color: var(--text-secondary);">a place for me to share random thoughts and quick ideas (micro-blog).</p>
  </div>

  <div class="space-y-4">
    {thoughts.map((thought) => (
      <div class={`thought-bubble ${thought.pinned ? 'border-orange-500/30' : ''}`} style={thought.pinned ? 'border-color: rgba(249, 115, 22, 0.35);' : undefined}>
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            {thought.pinned && (
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded flex items-center gap-1 bg-orange-500/10 text-orange-400 border border-orange-500/20" title="Pinned Thought">
                📌 pinned
              </span>
            )}
            <span class="text-[11px] font-mono" style="color: var(--text-muted);">{formatDate(thought.publishDate)}</span>
          </div>
          {(thought.tags || []).length > 0 && (
            <div class="flex gap-1">
              {(thought.tags || []).map((tag) => (
                <span class="tech-tag text-[10px]">#{tag}</span>
              ))}
            </div>
          )}
        </div>
        <div class="thought-content prose max-w-none">
          <Fragment set:html={thought.htmlContent} />
        </div>
      </div>
    ))}

    {thoughts.length === 0 && (
      <p class="text-xs italic py-4" style="color: var(--text-muted);">No thoughts logged yet.</p>
    )}
  </div>
</BaseLayout>
