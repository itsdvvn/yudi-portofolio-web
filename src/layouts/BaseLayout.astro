---
import '../styles/global.css';
import { reader } from '../lib/reader';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

// Read singletons live at runtime so CMS edits appear instantly
const siteData = (await (reader.singletons as any).site?.read()) || (await (reader.singletons as any).profile?.read()) || {};
const aboutData = (await (reader.singletons as any).about?.read()) || (await (reader.singletons as any).profile?.read()) || {};
const footerData = (await (reader.singletons as any).footer?.read()) || (profileData as any)?.socials || {};
const socials = footerData || {};

const showAboutNavbar = !!aboutData.showInNavbar;

const {
  title = siteData.siteTitle || "Wahyudi Setiawan (dvvn) – Multimedia Creator & Visual Storyteller",
  description = siteData.siteDescription || "Personal space of Wahyudi Setiawan (dvvn). Multimedia creator focused on visual storytelling, photography, cinematic video, and creative web exploration.",
  image = "/itsdvvn-web.jpg",
  type = 'website',
  publishDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, 'https://itsdvvn.my.id').href;
const imageUrl = image.startsWith('http') ? image : `https://itsdvvn.my.id${image}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "BlogPosting" : "Person",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  ...(type === 'article' && publishDate ? { "datePublished": publishDate } : {}),
  "author": {
    "@type": "Person",
    "name": "Wahyudi Setiawan",
    "url": "https://itsdvvn.my.id"
  }
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/jpeg" href="/itsdvvn-web.jpg" />
    <link rel="apple-touch-icon" href="/itsdvvn-web.jpg" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Primary Google Search Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Wahyudi Setiawan" />
    <meta name="theme-color" content="#121212" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="dvvn" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />
    {socials.xTwitter && <meta name="twitter:creator" content="@itsdvvn" />}

    <!-- Google Search Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Strict Default: Light Mode (without following OS dark preference)
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light'; // Default always light
      })();

      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>
  </head>
  <body class="py-6 sm:py-8 md:py-12">
    <div class="site-wrap flex-1 flex flex-col">
      <!-- Responsive Header -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 mb-8 sm:mb-12 border-b sm:border-b-0 pb-3.5 sm:pb-0" style="border-color: var(--border);">
        <div class="flex items-center justify-between w-full sm:w-auto">
          <a href="/" class="text-lg sm:text-base font-bold tracking-tight hover:opacity-80 transition-opacity" style="color: var(--text-primary);">
            dvvn
          </a>

          <!-- Mobile Theme Toggle & CMS shortcut -->
          <div class="flex sm:hidden items-center gap-2">
            <button id="theme-toggle-mobile" class="theme-toggle-btn p-1.5 rounded border text-zinc-400 hover:text-zinc-100" style="border-color: var(--border);" aria-label="Toggle Theme">
              <svg class="sun-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              <svg class="moon-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
            <a href="/keystatic" title="Keystatic CMS" class="px-2 py-1 rounded border text-[11px] font-mono" style="border-color: var(--border); color: var(--text-muted);">
              cms
            </a>
          </div>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-3 sm:gap-5 w-full sm:w-auto overflow-x-auto no-scrollbar py-0.5">
          <nav class="flex items-center gap-4 sm:gap-5 text-sm sm:text-sm">
            <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>home</a>
            <a href="/writings" class={`nav-link ${currentPath.startsWith('/writings') ? 'active' : ''}`}>writings</a>
            <a href="/thoughts" class={`nav-link ${currentPath.startsWith('/thoughts') ? 'active' : ''}`}>thoughts</a>
            <a href="/ships" class={`nav-link ${currentPath.startsWith('/ships') ? 'active' : ''}`}>ships</a>
            {showAboutNavbar && (
              <a href="/about" class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}>about me</a>
            )}
          </nav>
          
          <div class="hidden sm:flex items-center gap-2 border-l pl-3 shrink-0" style="border-color: var(--border);">
            <button id="theme-toggle" class="theme-toggle-btn transition-colors p-1" style="color: var(--text-muted);" aria-label="Toggle Theme">
              <svg class="sun-icon hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              <svg class="moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
            <a href="/keystatic" title="Keystatic CMS" class="transition-colors p-1 text-[11px] sm:text-xs font-mono" style="color: var(--text-muted);">
              [cms]
            </a>
          </div>
        </div>
      </header>

      <!-- Content Slot -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- Clean Social Icons & Contact Footer (Matching Screenshot) -->
      <footer class="mt-14 sm:mt-20 pt-6 sm:pt-8 border-t flex items-center justify-between gap-4" style="border-color: var(--border); color: var(--text-muted);">
        <!-- Social Icons Left -->
        <div class="flex items-center gap-4 text-zinc-400">
          {socials.youtube && (
            <a href={socials.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="YouTube" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15"/></svg>
            </a>
          )}
          {socials.instagram && (
            <a href={socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="Instagram" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
          )}
          {socials.tiktok && (
            <a href={socials.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="TikTok" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          )}
          {socials.discord && (
            <a href={socials.discord} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="Discord" aria-label="Discord">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6h0a14.5 14.5 0 0 0-4-1.5 9.87 9.87 0 0 0-.5 1.5 12.64 12.64 0 0 0-3 0 9.87 9.87 0 0 0-.5-1.5 14.5 14.5 0 0 0-4 1.5C3.5 10 3 14 3.5 18a15.84 15.84 0 0 0 4.5 2.5c.5-.5 1-1.5 1-2a10.6 10.6 0 0 1-2-.5c.2-.2.4-.3.5-.5a11.5 11.5 0 0 0 9 0c.2.2.4.3.5.5a10.6 10.6 0 0 1-2 .5c0 .5.5 1.5 1 2a15.84 15.84 0 0 0 4.5-2.5c.5-4 0-8-2.5-12z"/><circle cx="8.5" cy="13.5" r="1.5"/><circle cx="15.5" cy="13.5" r="1.5"/></svg>
            </a>
          )}
          {socials.github && (
            <a href={socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="GitHub" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
          )}
          {socials.xTwitter && (
            <a href={socials.xTwitter} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 transition-colors" title="X" aria-label="X">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
            </a>
          )}
        </div>

        <!-- Contact & Legal Right -->
        <div class="flex items-center gap-4 text-xs font-mono">
          <a href="/privacy" class="hover:underline tracking-tight" style="color: var(--text-muted);">
            privacy
          </a>
          {socials.email && (
            <a href={`mailto:${socials.email}`} class="text-sm font-sans font-medium hover:underline tracking-tight" style="color: var(--text-primary);">
              Contact
            </a>
          )}
        </div>
      </footer>
    </div>

    <script is:inline>
      const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
      const sunIcons = document.querySelectorAll('.sun-icon');
      const moonIcons = document.querySelectorAll('.moon-icon');

      function updateIcon(isDark) {
        // If dark mode is active, show sun icon (to switch to light); if light mode, show moon icon (to switch to dark)
        sunIcons.forEach(icon => isDark ? icon.classList.remove('hidden') : icon.classList.add('hidden'));
        moonIcons.forEach(icon => isDark ? icon.classList.add('hidden') : icon.classList.remove('hidden'));
      }

      const isInitiallyDark = document.documentElement.getAttribute('data-theme') === 'dark';
      updateIcon(isInitiallyDark);

      themeToggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const isCurrentlyDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isCurrentlyDark) {
            // Switch to Light
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
            updateIcon(false);
          } else {
            // Switch to Dark
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
            updateIcon(true);
          }
        });
      });
    </script>
  </body>
</html>
