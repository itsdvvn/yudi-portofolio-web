---
interface Props {
  articleTitle?: string;
}

const { articleTitle = 'Writings' } = Astro.props;
---

<div class="newsletter-section mt-16 pt-8 border-t" style="border-color: var(--border);">
  <div class="space-y-2 mb-4">
    <h3 class="text-sm font-medium tracking-tight" style="color: var(--text-primary);">
      Subscribe
    </h3>
    <p class="text-xs leading-relaxed" style="color: var(--text-secondary);">
      Get notified when I publish new writings and projects. No spam, unsubscribe anytime.
    </p>
  </div>

  <form id="newsletter-form" class="space-y-2">
    <input type="hidden" id="newsletter-source" value={articleTitle} />
    
    <div class="flex items-center gap-2 max-w-md">
      <input 
        type="email" 
        id="newsletter-email" 
        required 
        placeholder="your email address..." 
        class="flex-1 px-3 py-1.5 text-xs rounded border transition-colors font-mono focus:outline-none focus:border-zinc-400"
        style="border-color: var(--border); background-color: var(--tag-bg); color: var(--text-primary);"
      />
      <button 
        type="submit" 
        id="newsletter-submit-btn"
        class="px-3.5 py-1.5 text-xs font-mono rounded border transition-all flex items-center justify-center gap-1.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed hover:bg-zinc-800 hover:text-white"
        style="border-color: var(--border); color: var(--text-primary); background-color: var(--card-bg);"
      >
        <span id="newsletter-btn-text">Join</span>
        <span id="newsletter-btn-spinner" class="hidden animate-spin">⌛</span>
      </button>
    </div>

    <!-- Feedback Messages -->
    <div id="newsletter-message" class="text-[11px] hidden pt-1 font-mono"></div>
  </form>
</div>

<script is:inline>
  const form = document.getElementById('newsletter-form');
  const emailInput = document.getElementById('newsletter-email');
  const sourceInput = document.getElementById('newsletter-source');
  const submitBtn = document.getElementById('newsletter-submit-btn');
  const btnText = document.getElementById('newsletter-btn-text');
  const btnSpinner = document.getElementById('newsletter-btn-spinner');
  const messageDiv = document.getElementById('newsletter-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = emailInput.value.trim();
      const sourceArticle = sourceInput ? sourceInput.value : 'Writings';

      if (!email) return;

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = '...';
      btnSpinner.classList.remove('hidden');
      messageDiv.classList.add('hidden');
      messageDiv.textContent = '';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, sourceArticle }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          messageDiv.textContent = '✓ Subscribed. Thank you!';
          messageDiv.style.color = 'var(--text-secondary)';
          messageDiv.classList.remove('hidden');
          emailInput.value = '';
        } else {
          messageDiv.textContent = '✕ ' + (result.error || 'Something went wrong.');
          messageDiv.style.color = '#ef4444';
          messageDiv.classList.remove('hidden');
        }
      } catch (err) {
        messageDiv.textContent = '✕ Failed to connect to server.';
        messageDiv.style.color = '#ef4444';
        messageDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Join';
        btnSpinner.classList.add('hidden');
      }
    });
  }
</script>
